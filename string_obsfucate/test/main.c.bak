#include <stdio.h>
#include "decodestring.h"


const char* get_format()
{
    return DECODE("Print with format %d: %s\t%c\n");
}

int main(int argc, char** argv)
{
    int value = 5;
    const char* myString = DECODE("This is my test string and which remains triangular.");
    char character = 'b';

    printf(get_format(), value, myString, character);

    return 0;
}