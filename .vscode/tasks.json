        {
            "label": "Compile C++ (Linux)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "main.cpp"//"${file}"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "condition": "os == 'linux'"
        },
        {
            "type": "cppbuild",
            "label": "build windows",
            "command": "cl.exe",
            "args": [
                "/std:c++17",
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${workspaceFolder}\\build\\debug\\main.exe",
                "/Fo${workspaceFolder}\\build\\debug\\",
                "/Fd${workspaceFolder}\\build\\debug\\",
                "${workspaceFolder}\\main.cpp"//"${file}"
            ],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": [ "$msCompile" ],
            "condition": "os == 'windows'",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "clean windows",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Remove-Item -Path 'build\\debug\\*.obj', 'build\\debug\\*.ilk', 'build\\debug\\*.pdb' -Force"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}